# demo | live | hybrid
HW_MODE=live

# Dashboard (keep it private! bind to localhost and use an SSH tunnel, or set a token)
HW_DASH_HOST=127.0.0.1
HW_DASH_PORT=8000
HW_DASH_TOKEN=change-me-to-a-long-random-string

# Honeypot sensors (map public 22/23/80 to these with Docker or iptables)
HW_SSH_PORT=2222
HW_TELNET_PORT=2323
HW_HTTP_PORT=8080
HW_TCP_PORTS=3389,5900,3306,6379,9200
HW_FAKE_HOSTNAME=srv-prod-01

# Where your honeypot lives (target point on the globe)
HW_SENSOR_LABEL=Frankfurt, DE
HW_SENSOR_LAT=50.11
HW_SENSOR_LON=8.68

# Threat intel (optional)
HW_GEOIP=1
ABUSEIPDB_API_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=high
